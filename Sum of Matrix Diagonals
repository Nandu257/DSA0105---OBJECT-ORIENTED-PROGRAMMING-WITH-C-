#include <iostream>

int main() {
    int n;
    
    if (!(std::cin >> n)) {
        return 1;
    }
    
    int mat[100][100];
    for (int i = 0; i < n; ++i) {
        for (int j = 0; j < n; ++j) {
            std::cin >> mat[i][j];
        }
    }
    
    int principal_sum = 0;
    int secondary_sum = 0;
    
    for (int i = 0; i < n; ++i) {
        principal_sum += mat[i][i];
        secondary_sum += mat[i][n - 1 - i];
    }
    
    std::cout << principal_sum << std::endl;
    std::cout << secondary_sum << std::endl;
    
    return 0;
}


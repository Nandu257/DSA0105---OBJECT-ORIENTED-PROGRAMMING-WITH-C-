#include <iostream>

int main() {
    int n, element, pos;
    
    if (!(std::cin >> n)) {
        return 1;
    }
    
    int arr[100];
    for (int i = 0; i < n; ++i) {
        std::cin >> arr[i];
    }
    
    if (!(std::cin >> element >> pos)) {
        return 1;
    }
    
    for (int i = n; i > pos; --i) {
        arr[i] = arr[i - 1];
    }
    
    arr[pos] = element;
    n++;
    
    for (int i = 0; i < n; ++i) {
        std::cout << arr[i] << " ";
    }
    std::cout << std::endl;
    
    return 0;
}


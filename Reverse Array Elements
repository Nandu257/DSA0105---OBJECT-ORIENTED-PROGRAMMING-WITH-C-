#include <iostream>

int main() {
    int n;
    
    if (!(std::cin >> n)) {
        return 1;
    }
    
    int arr[100];
    for (int i = 0; i < n; ++i) {
        std::cin >> arr[i];
    }
    
    int start = 0;
    int end = n - 1;
    while (start < end) {
        int temp = arr[start];
        arr[start] = arr[end];
        arr[end] = temp;
        start++;
        end--;
    }
    
    for (int i = 0; i < n; ++i) {
        std::cout << arr[i] << " ";
    }
    std::cout << std::endl;
    
    return 0;
}


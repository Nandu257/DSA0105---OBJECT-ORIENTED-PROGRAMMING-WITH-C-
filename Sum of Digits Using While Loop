#include <iostream>

int main() {
    int num;
    
    if (!(std::cin >> num)) {
        return 1;
    }
    
    if (num < 0) {
        num = -num;
    }
    
    int sum = 0;
    while (num > 0) {
        sum += num % 10;
        num /= 10;
    }
    
    std::cout << sum << std::endl;
    
    return 0;
}


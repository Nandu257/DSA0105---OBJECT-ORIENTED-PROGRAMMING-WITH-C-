#include <iostream>

double calculateArea(double radius) {
    const double PI = 3.14159265358979323846;
    return PI * radius * radius;
}

int main() {
    double radius;
    
    if (!(std::cin >> radius)) {
        return 1;
    }
    
    std::cout << calculateArea(radius) << std::endl;
    
    return 0;
}


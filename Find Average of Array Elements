#include <iostream>

int main() {
    int n;
    
    if (!(std::cin >> n)) {
        return 1;
    }
    
    if (n <= 0) {
        std::cout << 0 << std::endl;
        return 0;
    }
    
    int arr;
    double sum = 0;
    
    for (int i = 0; i < n; ++i) {
        std::cin >> arr[i];
        sum += arr[i];
    }
    
    double average = sum / n;
    std::cout << average << std::endl;
    
    return 0;
}


#include <iostream>

int main() {
    int n, pos;
    
    if (!(std::cin >> n)) {
        return 1;
    }
    
    int arr[100];
    for (int i = 0; i < n; ++i) {
        std::cin >> arr[i];
    }
    
    if (!(std::cin >> pos)) {
        return 1;
    }
    
    if (pos >= 0 && pos < n) {
        for (int i = pos; i < n - 1; ++i) {
            arr[i] = arr[i + 1];
        }
        n--;
    }
    
    for (int i = 0; i < n; ++i) {
        std::cout << arr[i] << " ";
    }
    std::cout << std::endl;
    
    return 0;
}

